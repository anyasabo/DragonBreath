{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Fork-only. Updates the actions (SHA pins), the container digests, the ESP-IDF version and the pinned Python tools of CI. The ESP Component Registry and the dragon-core pin have no Renovate datasource: update them with a build, so that dependencies.lock stays current.",
  "extends": [
    "config:best-practices",
    ":semanticCommitsDisabled",
    ":disableDependencyDashboard"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The ESP-IDF version of the release and CI builds",
      "managerFilePatterns": ["/^\\.idf-version$/"],
      "matchStrings": ["^(?<currentValue>v\\d+\\.\\d+(?:\\.\\d+)?)\\s*$"],
      "depNameTemplate": "espressif/esp-idf",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "The ESP-IDF version of the compatibility job",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["esp_idf_version: (?<currentValue>v\\d+\\.\\d+(?:\\.\\d+)?)\\n"],
      "depNameTemplate": "espressif/esp-idf",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Python tools pinned in the workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["(?<depName>esp-idf-sbom|gcovr)==(?<currentValue>[0-9][0-9.]*)"],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "The compatibility job checks the oldest supported ESP-IDF line: patch updates only",
      "matchDepNames": ["espressif/esp-idf"],
      "matchFileNames": [".github/workflows/**"],
      "allowedVersions": "<5.4"
    },
    {
      "description": "Group the GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "groupName": "GitHub Actions"
    }
  ]
}
